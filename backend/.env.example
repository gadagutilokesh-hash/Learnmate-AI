# ==============================================================================
# LearnMate AI - Backend Environment Configuration (.env.example)
# ==============================================================================

# Application Settings
APP_NAME="LearnMate AI Backend"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Multi-Provider Configuration ("gemini", "groq", or "nvidia")
AI_PROVIDER="gemini"

# Gemini AI API Configuration (https://aistudio.google.com/)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_MULTIMODAL_MODEL="gemini-3.8-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
EMBEDDING_DIMENSION=768

# GroqCloud API Configuration (https://console.groq.com/)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# NVIDIA Nemotron API Configuration (https://build.nvidia.com/)
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="nvidia/llama-3.1-nemotron-70b-instruct"

# Database Configuration (Supabase PostgreSQL / Local Fallback)
# Optional: If SUPABASE_URL is not set, LearnMate AI automatically runs in local embedded mode
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your_supabase_anon_or_service_key"

# Retrieval & Chunking Settings
CHUNK_SIZE=500
CHUNK_OVERLAP=100
HYBRID_ALPHA=0.5
TOP_K_RETRIEVAL=6
MIN_RELEVANCE_SCORE=0.35

# Evaluation Settings
EVAL_BATCH_SIZE=5
