# ==============================================================================
# LearnMate AI - Backend Environment Configuration
# ==============================================================================

# Application Settings
APP_NAME=LearnMate AI Backend
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Gemini AI API Configuration
# Get your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MULTIMODAL_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Database Configuration (Supabase PostgreSQL / Local Fallback)
# Optional: If SUPABASE_URL is not set, LearnMate AI automatically runs in local embedded mode
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key
# Alternatively direct Postgres connection string:
# DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Retrieval & Chunking Settings
CHUNK_SIZE=500
CHUNK_OVERLAP=100
HYBRID_ALPHA=0.5
TOP_K_RETRIEVAL=6
MIN_RELEVANCE_SCORE=0.45

# Evaluation Settings
EVAL_BATCH_SIZE=5
